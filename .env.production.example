NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://mongodb:27017/sailingloc
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
SERVER_URL=https://api.your-domain.com
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="SailingLoc <no-reply@your-domain.com>"
SMTP_SECURE=false
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

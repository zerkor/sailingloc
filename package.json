{
  "name": "sailingloc",
  "version": "1.0.0",
  "private": true,
  "description": "SailingLoc monorepo deployment helper",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "postinstall": "npm run build",
    "build": "npm --prefix server install --include=dev && npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test": "npm --prefix server test",
    "test:coverage": "npm --prefix server run test:coverage",
    "test:e2e": "npm --prefix client run test:e2e",
    "test:e2e:ui": "npm --prefix client run test:e2e:ui",
    "validate:db": "npm --prefix server run validate:db",
    "validate:deploy": "node scripts/post-deploy-check.js",
    "load:constant": "k6 run load-tests/constant-load.js",
    "load:spike": "k6 run load-tests/spike-test.js",
    "load:stress": "k6 run load-tests/stress-test.js",
    "load:bookings": "k6 run load-tests/api-bookings.js",
    "load:payments": "k6 run load-tests/api-payments.js",
    "server:install": "npm --prefix server install",
    "server:start": "npm --prefix server start",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build"
  },
  "engines": {
    "node": ">=20 <25"
  }
}
